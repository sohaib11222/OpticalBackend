APP_NAME=Laravel
# Display name is independent of existing session/cache identifiers.
APP_DISPLAY_NAME="Vista Express 360"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail testing: fill these three blank values locally; never commit an App Password.
# MAIL_USERNAME and MAIL_FROM_ADDRESS must be the same testing Gmail address.
# MAIL_PASSWORD is the Google App Password, without its display spaces.
# See docs/gmail-smtp-testing.md at the repository root for worker/setup steps.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_REQUIRE_TLS=true
MAIL_TIMEOUT=30
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Optical Shop CRM - Testing"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SHOP_URL=http://localhost:5173/pulse-ui
ADMIN_URL=http://localhost:5174
REGISTRATION_REQUIRES_APPROVAL=true
# Local development only: false allows unverified accounts without changing verification records.
# Production/staging always require verification regardless of this flag.
EMAIL_VERIFICATION_REQUIRED=true
AUTH_ABSOLUTE_MINUTES=0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
SESSION_COOKIE=optical_session

# ClamAV must be reachable over a private/local network. Uploads stay unavailable without a clean verdict.
CLAMD_ADDRESS=tcp://127.0.0.1:3310

# Use defender on a Windows worker, or clamav with a real ClamAV daemon.
FILE_SCANNER=clamav
# Ordinary product photographs are validated, antivirus-scanned and
# normalized in the upload request so a healthy image is immediately usable.
# Set false only when a dedicated uploads queue is intentionally required.
PRODUCT_IMAGES_SYNC=true

# Optional Vista Express connection. Secret belongs only in these server environments.
VISTA_ENABLED=false
VISTA_BASE_URL=http://localhost:8010
VISTA_CLIENT_ID=optical-shop
VISTA_CLIENT_SECRET=
VISTA_REDIRECT_URI=http://localhost:5173/pulse-ui/auth/vista/callback
# Publish ordinary CRM products immediately and return a final result. Large
# image sets still use the integrations worker as a safe fallback.
VISTA_PUBLICATIONS_SYNC=true
VISTA_PUBLICATIONS_SYNC_MAX_IMAGES=12
# Must match the Marketplace VISTA360_CRM_WEBHOOK_SECRET. It is used only for
# signed entitlement invalidation events; ordinary subscription checks still
# revalidate against the Marketplace provider.
VISTA360_CRM_WEBHOOK_SECRET=
VISTA360_ENTITLEMENT_TTL_SECONDS=15
VISTA360_ENTITLEMENT_MAX_STALE_SECONDS=0
VISTA360_ADMIN_BRIDGE_ENABLED=false
VISTA360_ADMIN_BRIDGE_URL=
VISTA360_ADMIN_BRIDGE_SECRET=

SESSION_EXPIRE_ON_CLOSE=false

# Customer communication is email-only. WhatsApp uses browser click-to-chat;
# no SMS, Twilio or automated WhatsApp credentials are required.
COMMUNICATIONS_EMAIL_ENABLED=true
COMMUNICATIONS_EMAIL_SYNC=true
COMMUNICATIONS_PUBLIC_URL=http://localhost:8000
COMMUNICATIONS_PER_MINUTE=30
ARUBA_SMTP_HOST=smtps.aruba.it
ARUBA_SMTP_PORT=465
ARUBA_SMTP_USERNAME=
ARUBA_SMTP_PASSWORD=
ARUBA_FROM_ADDRESS=
ARUBA_FROM_NAME="Vista Express 360"

# Small user-facing uploads complete securely in the request by default. Set
# a value to false only when the uploads worker is intentionally used instead.
PRODUCT_IMAGES_SYNC=true
PRIVATE_FILES_SYNC=true
CUSTOMER_IMPORTS_SYNC=true
