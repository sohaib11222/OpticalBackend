APP_NAME=Laravel
# Display name is independent of existing session/cache identifiers.
APP_DISPLAY_NAME="Vista Express 360"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail testing: fill these three blank values locally; never commit an App Password.
# MAIL_USERNAME and MAIL_FROM_ADDRESS must be the same testing Gmail address.
# MAIL_PASSWORD is the Google App Password, without its display spaces.
# See docs/gmail-smtp-testing.md at the repository root for worker/setup steps.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_REQUIRE_TLS=true
MAIL_TIMEOUT=30
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Optical Shop CRM - Testing"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SHOP_URL=http://localhost:5173/pulse-ui
ADMIN_URL=http://localhost:5174
REGISTRATION_REQUIRES_APPROVAL=true
# Local development only: false allows unverified accounts without changing verification records.
# Production/staging always require verification regardless of this flag.
EMAIL_VERIFICATION_REQUIRED=true
AUTH_ABSOLUTE_MINUTES=0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
SESSION_COOKIE=optical_session

# ClamAV must be reachable over a private/local network. Uploads stay unavailable without a clean verdict.
CLAMD_ADDRESS=tcp://127.0.0.1:3310

# Use defender on a Windows worker, or clamav with a real ClamAV daemon.
FILE_SCANNER=clamav

# Optional Vista Express connection. Secret belongs only in these server environments.
VISTA_ENABLED=false
VISTA_BASE_URL=http://localhost:8010
VISTA_CLIENT_ID=optical-shop
VISTA_CLIENT_SECRET=
VISTA_REDIRECT_URI=http://localhost:5173/pulse-ui/auth/vista/callback

SESSION_EXPIRE_ON_CLOSE=false

# Shared platform customer communications; independent of account verification mail.
COMMUNICATIONS_ENABLED=false
# Optional channel override: enable Aruba email without enabling Twilio SMS/WhatsApp.
# COMMUNICATIONS_EMAIL_ENABLED=true
COMMUNICATIONS_PUBLIC_URL=http://localhost:8000
COMMUNICATIONS_PER_MINUTE=30
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
ARUBA_SMTP_HOST=smtps.aruba.it
ARUBA_SMTP_PORT=465
ARUBA_SMTP_USERNAME=
ARUBA_SMTP_PASSWORD=
ARUBA_FROM_ADDRESS=
ARUBA_FROM_NAME="Vista Express 360"
